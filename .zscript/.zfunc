
sd(){
  cd $(fd -H -t d | fzf)
}

wa(){
	wal -n -i $1 --backend $2
}

wf() {
	wd $(wd list | awk 'NR > 1 {print $1}' | fzf)
}

hotspot(){
  switch=$1
  if [[ $switch == "up" ]]; then
    nmcli c up hotspot
    return 0;
  elif [[ $switch == "down" ]]; then
    nmcli c down hotspot
    return 0;
  fi
}

nx(){
	opt=$1
	input=$2
	args=$3
	case $opt in
		up)
			sudo nixos-rebuild switch $3
			;;
		f)
			sudo nixos-rebuild switch --flake ~/dotfiles#lighthouse
			;;
	esac

}

dl() {
  yt-dlp -f ba -x --audio-format flac --audio-quality 0 --add-metadata --embed-thumbnail -o "%(title)s.%(ext)s" $1
}
